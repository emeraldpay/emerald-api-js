{
  "name": "@emeraldpay/api",
  "version": "0.7.0-dev",
  "description": "Common code for Emerald gRPC APIs",
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emeraldpay/emerald-api-js.git"
  },
  "keywords": [
    "grpc",
    "api",
    "emerald",
    "emerald-pay",
    "emerald-wallet"
  ],
  "scripts": {
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "build": "npm run clean && npm run init && npm run generate && npm run build:ts",
    "build:ts": "tsc",
    "clean": "rimraf lib src/generated",
    "generate": "npm run init && npm run generate:js && npm run generate:ts && npm run generate:copy",
    "generate:copy": "rimraf src/generated && cp -r lib/generated src/",
    "generate:js": "grpc_tools_node_protoc --js_out=import_style=commonjs:./lib/generated --plugin=protoc-gen-grpc=`which grpc_tools_node_protoc_plugin` -I ../../api-definitions/proto ../../api-definitions/proto/*.proto ../../api-definitions/proto/google/api/*.proto",
    "generate:ts": "grpc_tools_node_protoc --plugin=protoc-gen-ts=`which protoc-gen-ts` --ts_out=./lib/generated -I ../../api-definitions/proto ../../api-definitions/proto/*.proto ../../api-definitions/proto/google/api/*.proto",
    "init": "mkdir -p lib/generated",
    "test": "jest"
  },
  "dependencies": {
    "google-protobuf": "^3.21.4",
    "protobufjs": "^8.8.1"
  },
  "devDependencies": {
    "@types/google-protobuf": "^3.15.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "grpc-tools": "^1.13.1",
    "grpc_tools_node_protoc_ts": "^5.3.3",
    "jest": "^30.5.2",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  }
}
